# Fourni automatiquement par l'intégration Neon du Marketplace Vercel (Storage → Neon).
DATABASE_URL=postgres://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Secret de signature des sessions soignant : 32 caractères aléatoires minimum.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Adresse publique de l'application (sert à afficher le lien d'installation après le seed).
APP_URL=https://anna.vercel.app
